    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpEnableSsl" value="true" />
    <add key="SmtpUser" value="nvu17326@gmail.com" />
    <add key="SmtpPassword" value="hrcbhecokjsqgchq" />
    <add key="SmtpFromAddress" value="nvu17326@gmail.com" />
    <add key="SmtpFromName" value="CanvasApp" />
    <add key="OtpExpirationMinutes" value="5" />
  </appSettings>
  <runtime>
