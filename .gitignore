## .gitignore

# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
packages/
*.nupkg

# OS files
Thumbs.db
.DS_Store

# IDE
*.resharper
.idea/

# Compiled
*.exe
*.dll
*.pdb

# Secrets / local config (never commit credentials)
App.secrets.config
*.secrets.config
!*.secrets.config.example
.env
.env.*
!.env.example
*.pfx
*.p12

# Claude Code local settings
.claude/settings.local.json