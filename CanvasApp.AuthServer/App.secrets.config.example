<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to App.secrets.config (same folder) and fill in real values.
  App.secrets.config is git-ignored and copied to the output folder on build.
  For Gmail, SmtpPassword must be an App Password (16 chars, no spaces):
  https://myaccount.google.com/apppasswords
-->
<appSettings>
  <add key="SmtpUser" value="your-account@gmail.com" />
  <add key="SmtpPassword" value="your-16-char-app-password" />
  <add key="SmtpFromAddress" value="your-account@gmail.com" />
</appSettings>
